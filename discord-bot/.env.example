# Discord Developer Portal (discord.com/developers/applications) - your application's Bot tab.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Your Guidon deployment's public URL, no trailing slash. The bot calls its
# /api/v1 (the AI Task API) with whatever key each Discord server links.
GUIDON_API_URL=https://your-guidon-instance.example.com

# Must be the EXACT same value as Guidon's own AUTH_SECRET env var - this
# bot decrypts/encrypts the same discord_integrations columns Guidon's web
# app does, and both sides derive their encryption key from this secret.
AUTH_SECRET=

# --- Database access: set ONE of the two blocks below, matching how your
# Guidon deployment itself is configured (see the main repo's README) ---

# Self-hosted Postgres:
# DATABASE_URL=postgres://user:password@host:5432/guidon

# Guidon Cloud / Supabase:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

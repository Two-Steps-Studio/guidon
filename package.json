{
  "name": "guidon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/sdk-js",
    "packages/cli"
  ],
  "scripts": {
    "predev": "node scripts/build-plugin-zips.mjs",
    "dev": "next dev --webpack -p 5803",
    "prebuild": "node scripts/build-plugin-zips.mjs && node scripts/copy-monaco-assets.mjs",
    "build": "next build",
    "postbuild": "node scripts/standalone-package.mjs",
    "start": "next start -p 5803",
    "lint": "eslint",
    "postinstall": "node scripts/copy-monaco-assets.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "test:db": "node --experimental-strip-types tests/db/compat.test.mjs",
    "test:task-editing": "node --experimental-strip-types tests/db/task-edit-revision.test.mjs",
    "test:board-pan": "node tests/board-pan.test.cjs",
    "test:ai": "node --experimental-strip-types tests/ai/provider.test.mjs && node --experimental-strip-types tests/ai/task-learning.test.mjs && node --conditions=react-server --experimental-strip-types tests/ai/provider-transport.test.mjs && node --conditions=react-server --experimental-strip-types tests/ai/chat-route.test.mjs",
    "test:auth": "node --experimental-strip-types tests/auth/local-auth.test.mjs && node --experimental-strip-types tests/auth/oauth.test.mjs && node --experimental-strip-types tests/auth/mobile-login.test.mjs && node --experimental-strip-types tests/auth/oauth-server.test.mjs && node --experimental-strip-types tests/auth/account-deletion.test.mjs && node --experimental-strip-types --test tests/auth/client-assertion.test.mjs && node --experimental-strip-types --conditions=react-server tests/auth/session-cookie.test.mjs",
    "test:limits": "node tests/limits.test.mjs",
    "test:reports": "node --experimental-strip-types tests/game-report.test.mjs",
    "test:github": "node --experimental-strip-types tests/github-webhook.test.mjs",
    "test:webhooks": "node --experimental-strip-types tests/webhooks.test.mjs && node --experimental-strip-types --test tests/webhook-delivery.test.mjs",
    "test:agent-web": "node --experimental-strip-types --import ./tests/fixtures/register-app-paths.mjs tests/agent-web.test.mjs",
    "test:agent-readiness": "node --experimental-strip-types --test tests/agent-readiness.test.mjs tests/web-bot-auth.test.mjs",
    "test:agent-claims": "node --experimental-strip-types --import ./tests/fixtures/register-app-paths.mjs --test tests/auth/agent-claims.test.mjs tests/db/agent-claims.test.mjs",
    "verify:agent-readiness": "node scripts/verify-agent-readiness.mjs",
    "test:labels": "node --experimental-strip-types tests/label-presets.test.mjs && node tests/server-errors.test.mjs",
    "test:import": "node tests/task-import.test.mjs",
    "test:recurrence": "node tests/recurrence.test.mjs",
    "test:context": "node --experimental-strip-types tests/context-pack.test.mjs",
    "test:restore": "node tests/ops/restore-drill.mjs",
    "perf:large": "node tests/perf/large-project.mjs --budgets tests/perf/budgets.json",
    "test:billing": "node tests/billing.test.mjs && node --experimental-strip-types --import ./tests/fixtures/work-resolver.mjs tests/billing-webhook.test.mjs",
    "test:modules": "node --experimental-strip-types tests/custom-modules.test.mjs && node --experimental-strip-types tests/module-manifest.test.mjs && node --experimental-strip-types --import ./tests/fixtures/work-resolver.mjs tests/module-runtime.test.mjs && node --experimental-strip-types tests/module-installation.test.mjs && node --experimental-strip-types tests/module-lifecycle.test.mjs && node --experimental-strip-types tests/module-builder.test.mjs && node --experimental-strip-types --import ./tests/fixtures/work-resolver.mjs tests/module-registry.test.mjs && node --experimental-strip-types --import ./tests/fixtures/work-resolver.mjs tests/module-automation.test.mjs && node --experimental-strip-types --import ./tests/fixtures/work-resolver.mjs tests/module-sandbox.test.mjs",
    "test:module-catalog": "node --experimental-strip-types --import ./tests/fixtures/work-resolver.mjs tests/module-catalog.browser.mjs",
    "test:module-editor": "node --experimental-strip-types tests/module-draft.test.mjs && node --experimental-strip-types tests/module-preview.test.mjs && node tests/module-editor.browser.mjs",
    "test:e2e": "node tests/e2e/isolation.test.mjs && node tests/e2e/run.mjs",
    "test:package": "node tests/standalone-package.test.mjs",
    "test:dependencies": "node tests/dependencies.test.mjs && node tests/monaco.browser.mjs",
    "module-manifest:schema": "node --experimental-strip-types scripts/generate-module-manifest-schema.mjs",
    "test:attachments": "node tests/attachment-compression.test.mjs",
    "test:api": "node --experimental-strip-types tests/api-route.test.mjs",
    "test:feedback": "node --experimental-strip-types tests/feedback.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "16.4.3",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^11.0.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.7",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "3.4.17",
    "jose": "^6.2.13",
    "lucide-react": "^0.462.0",
    "monaco-editor": "0.57.0",
    "motion": "^13.4.4",
    "next": "16.4.3",
    "next-intl": "^4.14.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "prismjs": "^1.30.0",
    "dompurify": "$dompurify",
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  }
}

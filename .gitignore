# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated by scripts/copy-monaco-assets.mjs (postinstall)
/public/monaco-editor/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real ones stay out, the template is committed on purpose.
# Self-hosting depends on .env.example being in the repo (TODO.md §11, §26).
.env*
!.env.example

# vercel
.vercel

# local storage provider's default STORAGE_PATH (.env.example) - uploaded
# files, not source
/storage

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees (superpowers:using-git-worktrees)
.worktrees

# plugin build artifacts (packaged for manual install, not source)
plugins/**/__pycache__/
plugins/**/*.zip
plugins/**/build/
plugins/**/*.vsix

{
  "manifestVersion": 1,
  "id": "release-planning",
  "name": "Release planning",
  "version": "1.0.0",
  "author": {
    "name": "Guidon example"
  },
  "engine": {
    "minVersion": "1.0.0",
    "maxVersionExclusive": "2.0.0"
  },
  "permissions": ["module-data:read", "module-data:write"],
  "entities": [
    {
      "id": "release",
      "name": "Release",
      "fields": [
        { "id": "due", "name": "Release date", "type": "date", "required": false },
        {
          "id": "name",
          "name": "Name",
          "type": "text",
          "required": true,
          "maxLength": 120
        },
        {
          "id": "status",
          "name": "Status",
          "type": "select",
          "required": true,
          "options": [
            { "value": "planned", "label": "Planned" },
            { "value": "ready", "label": "Ready" },
            { "value": "shipped", "label": "Shipped" }
          ]
        }
      ]
    }
  ],
  "views": [
    { "id": "release-form", "name": "New release", "type": "form", "entity": "release", "fields": ["name", "status", "due"] },
    { "id": "release-board", "name": "Release board", "type": "board", "entity": "release", "fields": ["name", "status", "due"], "groupBy": "status" },
    { "id": "release-chart", "name": "Release status", "type": "chart", "entity": "release", "fields": ["name", "status"], "groupBy": "status" },
    { "id": "release-calendar", "name": "Release calendar", "type": "calendar", "entity": "release", "fields": ["name", "due"], "dateField": "due" },
    {
      "id": "release-table",
      "name": "Releases",
      "type": "table",
      "entity": "release",
      "fields": ["name", "status"]
    }
  ],
  "dataVersion": 1,
  "migrations": [],
  "lifecycle": {
    "install": "declarative",
    "enable": "immediate",
    "disable": "immediate",
    "uninstall": "retain_data"
  }
}

# =====================================================
# GUIDON — CONFIGURATION
# =====================================================
#
# Copy to .env.local and fill in. Only REQUIRED must be set — everything
# else has a working default or is optional. Full explanation of every
# variable: docs/configuration.md.
#
# Never commit .env.local. Never expose anything other than NEXT_PUBLIC_*
# to the browser.

# -----------------------------------------------------
# REQUIRED
# -----------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:2137
APP_URL=http://localhost:2137
NEXT_PUBLIC_APP_NAME=Guidon

# Signs local-storage URLs (and later, sessions). Generate: openssl rand -hex 32
AUTH_SECRET=

# -----------------------------------------------------
# ADMIN
# -----------------------------------------------------
# Comma-separated emails allowed into /admin. Unset = admin panel unreachable.
# ADMIN_EMAILS=you@example.com,teammate@example.com

# -----------------------------------------------------
# SIGN-IN PROVIDERS
# -----------------------------------------------------
# Comma-separated: google, discord, tss. Only listed providers show a button.
# See docs/auth-setup.md for the Google/Discord/Supabase setup steps.
# NEXT_PUBLIC_AUTH_PROVIDERS=google,discord

# -----------------------------------------------------
# DATABASE
# -----------------------------------------------------

# Cloud (Supabase) — the current default; required on every deployment path.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Only needed for the AI Task API (src/app/api/v1) on Guidon Cloud.
# Supabase: Project Settings → API → JWT Settings → JWT Secret.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Self-hosted PostgreSQL — talks to Postgres directly instead of through
# Supabase's REST layer. Required for `npm run migrate`. See docs/configuration.md.
# DATABASE_URL=postgresql://guidon:password@localhost:5432/guidon
# DATABASE_POOL_MAX=10

# -----------------------------------------------------
# STORAGE
# -----------------------------------------------------
# supabase (default) | local (filesystem, needs STORAGE_PATH) | s3 (not implemented)
STORAGE_PROVIDER=supabase
STORAGE_PATH=./storage

# Optional: sign storage URLs with a dedicated secret instead of AUTH_SECRET.
# STORAGE_SIGNING_SECRET=

# -----------------------------------------------------
# AI
# -----------------------------------------------------
# Optional — powers the Memory "Generate Insight" button and the Work board's
# AI task assistant. See docs/configuration.md for what each provider needs.
#
#   anthropic | openai | openrouter | groq | ollama | azure-openai | custom
#
# AI_PROVIDER=ollama
# AI_MODEL=qwen3
# AI_BASE_URL=http://ollama:11434

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# AI_API_KEY=

# Azure OpenAI — all four required together when AI_PROVIDER=azure-openai.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=

# -----------------------------------------------------
# INTEGRATIONS
# -----------------------------------------------------
# GitHub App for the Files page's "Connect repository" (Monaco code editor).
# Optional — without it, Files behaves as before. Not an OAuth App: create a
# GitHub App (Callback URL <origin>/api/github/callback, Setup URL
# <origin>/api/github/setup, "Any account" install access). See
# docs/configuration.md.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=

# =====================================================
# GUIDON - CONFIGURATION
# =====================================================
#
# Copy to .env.local and fill in. Only REQUIRED must be set - everything
# else has a working default or is optional. Full explanation of every
# variable: docs/configuration.md.
#
# Never commit .env.local. Never expose anything other than NEXT_PUBLIC_*
# to the browser.

# -----------------------------------------------------
# REQUIRED
# -----------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:5803
APP_URL=http://localhost:5803
NEXT_PUBLIC_APP_NAME=Guidon

# Signs local-storage URLs (and later, sessions). Generate: openssl rand -hex 32
AUTH_SECRET=

# -----------------------------------------------------
# ADMIN
# -----------------------------------------------------
# Comma-separated emails allowed into /admin. Unset = admin panel unreachable.
# ADMIN_EMAILS=you@example.com,teammate@example.com

# -----------------------------------------------------
# SIGN-IN PROVIDERS
# -----------------------------------------------------
# Password sign-in always works; these add "Sign in with ..." buttons.
# See docs/configuration.md (SIGN-IN PROVIDERS) and docs/auth-setup.md.
#
# Guidon Cloud / Supabase mode - providers enabled in the Supabase project:
# NEXT_PUBLIC_AUTH_PROVIDERS=google,github,discord,gitlab
#
# Self-hosted mode (DATABASE_URL set) - each provider is on when its keys are
# set. Callback URL to register: <APP_URL>/auth/oauth/<provider>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_URL=https://gitlab.com
# Any OpenID Connect issuer (Keycloak, Authentik, Entra ID, Two Steps Studio):
# OIDC_ISSUER=https://id.example.com/realms/studio
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Two Steps Studio

# -----------------------------------------------------
# DATABASE
# -----------------------------------------------------

# Cloud (Supabase) - the current default; required on every deployment path.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Only needed for the AI Task API (src/app/api/v1) on Guidon Cloud.
# Supabase: Project Settings → API → JWT Settings → JWT Secret.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Self-hosted PostgreSQL - talks to Postgres directly instead of through
# Supabase's REST layer. Required for `npm run migrate`. See docs/configuration.md.
# DATABASE_URL=postgresql://guidon:password@localhost:5432/guidon
# DATABASE_POOL_MAX=10

# -----------------------------------------------------
# STORAGE
# -----------------------------------------------------
# supabase (default) | local (filesystem, needs STORAGE_PATH) | s3 (not implemented)
STORAGE_PROVIDER=supabase
STORAGE_PATH=./storage

# Optional: sign storage URLs with a dedicated secret instead of AUTH_SECRET.
# STORAGE_SIGNING_SECRET=

# -----------------------------------------------------
# AI
# -----------------------------------------------------
# Optional - powers the Memory "Generate Insight" button and the Work board's
# AI task assistant. See docs/configuration.md for what each provider needs.
#
#   anthropic | openai | openrouter | groq | ollama | azure-openai | custom
#
# AI_PROVIDER=ollama
# AI_MODEL=qwen3
# AI_BASE_URL=http://ollama:11434

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# AI_API_KEY=

# Azure OpenAI - all four required together when AI_PROVIDER=azure-openai.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=

# -----------------------------------------------------
# ERROR TRACKING
# -----------------------------------------------------
# Optional - unset means Sentry.init() is never called, on server or client.
# See docs/configuration.md.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# -----------------------------------------------------
# BILLING (Guidon Cloud only - self-hosted installs have no plan limits)
# -----------------------------------------------------
# Optional - unset means the billing page shows a read-only plan comparison
# with no Upgrade/Manage billing buttons, same as before this existed. See
# docs/configuration.md and docs/superpowers/specs/2026-08-22-subscriptions-design.md.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------
# INTEGRATIONS
# -----------------------------------------------------
# GitHub App for the Files page's "Connect repository" (Monaco code editor).
# Optional - without it, Files behaves as before. Not an OAuth App: create a
# GitHub App (Callback URL <origin>/api/github/callback, Setup URL
# <origin>/api/github/setup, "Any account" install access). See
# docs/configuration.md.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# Optional: the App's webhook secret. With the App's webhook pointed at
# <origin>/api/github/webhook (Push + Pull request events), commits and PRs
# that mention guidon#<task-id-prefix> comment on and move that task.
# GITHUB_APP_WEBHOOK_SECRET=

# -----------------------------------------------------
# EMAIL: PASSWORD RESET AND INVITATIONS
# -----------------------------------------------------
# Required for the "Forgot password?" flow (hosted mode). Also sends
# invitation emails when someone adds an address without an account to an
# organization - in either mode; without these the invitation is still
# created and its link is shown to the inviter to share by hand. Guidon sends
# its own branded email via Resend's API (https://resend.com) rather than
# relying on Supabase's dashboard-configured SMTP/templates.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Guidon <noreply@useguidon.com>"

# -----------------------------------------------------
# WEB BOT AUTH (optional)
# -----------------------------------------------------
# An Ed25519 private JWK. When set, outgoing webhooks carry an HTTP Message
# Signature (RFC 9421, Signature-Agent / Signature-Input / Signature) and the
# public key is published at /.well-known/http-message-signatures-directory,
# so receivers can check a request comes from this server.
# WEB_BOT_AUTH_PRIVATE_KEY=
# File-based generator (does not print the private value):
#   node scripts/create-web-bot-auth-key.mjs .env.web-bot-auth.private.jwk
# Use a private directory/ACL. Paste its contents into the deployment secret,
# remove the local copy securely, and rotate before the key's exp timestamp.

# AGENT AUTH (optional, requires migration 085 before enabling)
# Separate Ed25519 private JWK for human-approved service_auth claims.
# Do not reuse the Web Bot Auth key. No anonymous/provider assertions supported.
# node scripts/create-web-bot-auth-key.mjs .env.agent-auth.private.jwk AGENT_AUTH_PRIVATE_KEY
# AGENT_AUTH_PRIVATE_KEY=

# MODULE REGISTRY SIGNATURES (optional, server-side)
# Ed25519 private JWK that signs every published module version (migration 093);
# installation refuses a version whose signature no longer matches its manifest.
# Its own key - do not reuse the two above. Public half: /.well-known/guidon-module-signing-keys.json
# node scripts/create-web-bot-auth-key.mjs .env.module-signing.private.jwk MODULE_SIGNING_KEY
# MODULE_SIGNING_KEY=

# LEGAL PUBLICATION (server-side, PUBLIC contact details only)
# New legal documents remain labelled review drafts until all contact fields
# and approval are configured. This flag does not certify legal compliance.
# Confirm the operator's identity/authority and obtain a qualified review first.
# LEGAL_OPERATOR_NAME=
# LEGAL_OPERATOR_ADDRESS=
# LEGAL_OPERATOR_PHONE=
# LEGAL_OPERATOR_EMAIL=guidon.support@gmail.com
# LEGAL_DOCUMENTS_APPROVED=false

# -----------------------------------------------------
# WEBHOOK RETRIES (optional)
# -----------------------------------------------------
# Failed webhook deliveries are retried after every new event; a cron call
# to /api/cron/webhooks also sends them during quiet periods. Set a long
# random value and call the endpoint every few minutes with
# "Authorization: Bearer <value>" (Vercel Cron sends it by itself).
# CRON_SECRET=

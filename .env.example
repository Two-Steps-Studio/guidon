# =====================================================
# GUIDON — CONFIGURATION
# =====================================================
#
# Copy to .env.local and fill in. Only the variables under REQUIRED
# must be set; everything else has a working default.
#
# Never commit .env.local. Never expose anything other than
# NEXT_PUBLIC_* to the browser.

# -----------------------------------------------------
# REQUIRED
# -----------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Guidon

# Secret used to sign local storage URLs (and, later, sessions).
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# -----------------------------------------------------
# ADMIN  (TODO.md §25)
# -----------------------------------------------------
#
# Comma-separated emails allowed into /admin, matched case-insensitively
# against the signed-in user's profile email. There is no admin role in the
# database — this is the entire gate (src/lib/data/admin-access.ts).
#
# Unset (the default) means the admin panel is unreachable by anyone, which
# is the safe default: nobody is silently an instance admin just because
# they're the first person to sign in.
#
# ADMIN_EMAILS=you@example.com,teammate@example.com

# -----------------------------------------------------
# SIGN-IN PROVIDERS
# -----------------------------------------------------
#
# Comma-separated. Only listed providers get a button, so an install with
# nothing configured stays password-only instead of showing buttons that
# fail on click.
#
#   google   requires the Google provider enabled in Supabase
#   discord  requires the Discord provider enabled in Supabase
#   tss      sign in with a Two Steps Studio account
#
# `tss` must never be the only entry: TODO.md §1 requires self-hosted
# Guidon to work with no TSS account and with TSS unreachable.
#
# See docs/auth-setup.md for the Google/Discord/Supabase steps.
# NEXT_PUBLIC_AUTH_PROVIDERS=google,discord

# -----------------------------------------------------
# DATABASE
# -----------------------------------------------------
#
# Cloud (Supabase) — the current default.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

SUPABASE_SESSION_EXPIRY=24

# -----------------------------------------------------
# SELF-HOSTED POSTGRESQL
# -----------------------------------------------------
#
# Set this to talk to PostgreSQL directly instead of going through
# Supabase's REST layer. Required for `npm run migrate`, and set
# automatically inside docker-compose.
#
# When the migration runner finds no auth.uid() in the database, it
# first applies src/db/bootstrap/000_auth_compat.sql, which recreates
# the Supabase primitives the schema depends on: the auth schema,
# auth.users, auth.uid(), and the anon / authenticated / service_role
# roles. On Supabase they already exist, so nothing is touched.
#
# Server code only. The browser never opens a connection — that is
# precisely what makes it safe for the server to assert identity by
# setting request.jwt.claims per transaction (src/lib/db/session.ts).
#
# DATABASE_URL=postgresql://guidon:password@localhost:5432/guidon

# Maximum pooled connections (default 10).
# DATABASE_POOL_MAX=10

# -----------------------------------------------------
# STORAGE
# -----------------------------------------------------
#
# supabase — managed bucket (default)
# local    — filesystem under STORAGE_PATH, served via /api/storage
# s3       — not implemented yet; the provider interface is ready for it
STORAGE_PROVIDER=supabase

# Only used when STORAGE_PROVIDER=local.
# Must be a persistent volume in Docker, or uploads vanish on restart.
STORAGE_PATH=./storage

# Optional: sign storage URLs with a dedicated secret instead of AUTH_SECRET.
# STORAGE_SIGNING_SECRET=

# -----------------------------------------------------
# AI  (TODO.md §6/§7)
# -----------------------------------------------------
#
# Optional. Guidon runs fine with no AI provider configured — nothing in
# the app calls one yet (src/lib/ai/provider.ts is the abstraction the
# first concrete feature, e.g. generating an ai_insight from a memory
# source, will build on). Leave AI_PROVIDER unset to disable AI entirely;
# /api/health reports "not_configured", which is a normal state.
#
# AI_PROVIDER selects the backend:
#
#   anthropic     Anthropic Messages API      — needs ANTHROPIC_API_KEY
#   openai        OpenAI chat completions      — needs OPENAI_API_KEY
#   openrouter    OpenRouter                   — needs OPENROUTER_API_KEY
#   ollama        Self-hosted, no API key — the provider TODO.md §6 requires
#                 for a fully local install where no project data leaves
#                 this machine. Talks to AI_BASE_URL (default below).
#   azure-openai  Azure OpenAI                 — needs AZURE_OPENAI_* below
#   custom        Any other OpenAI-compatible endpoint — needs AI_BASE_URL
#
# AI_MODEL is required for every provider except azure-openai, which
# selects the model via AZURE_OPENAI_DEPLOYMENT instead.
#
# AI_PROVIDER=ollama
# AI_MODEL=qwen3

# Base URL — used by ollama and custom only (openai/openrouter/azure-openai
# have fixed or dedicated endpoints). Ollama default: http://localhost:11434
# — its OpenAI-compatible surface is served under /v1, appended
# automatically, so set this to the plain host as used with `ollama serve`.
# AI_BASE_URL=http://ollama:11434

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Optional: only used when AI_PROVIDER=custom and the endpoint requires
# bearer-token auth. Ignored by every other provider.
# AI_API_KEY=

# Azure OpenAI — all four required when AI_PROVIDER=azure-openai.
# AZURE_OPENAI_ENDPOINT is the resource endpoint (no path); the deployment
# path and api-version query param are added automatically.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=

# -----------------------------------------------------
# INTEGRATIONS  (not implemented yet)
# -----------------------------------------------------
#
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

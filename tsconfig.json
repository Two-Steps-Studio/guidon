{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Self-contained sibling packages (own package.json/tsconfig/node_modules,
    // not part of the Next.js app) - discord-bot/ has real .ts files with
    // dependencies (discord.js) never installed at the repo root, so the
    // broad **/*.ts include above was picking them up and failing to
    // resolve those imports. Passed silently in local `tsc --noEmit` only
    // because discord-bot/node_modules happened to exist locally from its
    // own `npm install` - Vercel's build never runs that, so it failed
    // there. desktop/ has no offending .ts files today, excluded anyway for
    // the same reason eslint.config.mjs already excludes both.
    "desktop",
    "discord-bot",
    // Editor plugins - same class of bug: plugins/vscode/ is its own package
    // (@types/vscode installed only by its own `npm install`), so the root
    // type-check passed locally and failed on Vercel.
    "plugins"
  ]
}

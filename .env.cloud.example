# Guidon Cloud on your own server (docker-compose.cloud.yml).
# Copy to .env.cloud, fill in, keep private (chmod 600). Same names as the
# environment variables on Vercel - see docs/cloud-hosting.md for where each
# value comes from. Do NOT add DATABASE_URL: without it the app uses Supabase.

GUIDON_DOMAIN=useguidon.com
APP_URL=https://useguidon.com
NEXT_PUBLIC_APP_URL=https://useguidon.com
NEXT_PUBLIC_APP_NAME=Guidon

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
STORAGE_PROVIDER=supabase

# Must be the SAME value as on Vercel: it decrypts secrets already stored in
# the database (organization AI keys, webhook secrets, Discord links).
AUTH_SECRET=

# Any long random text (the script fills it in if empty).
CRON_SECRET=

ADMIN_EMAILS=
NEXT_PUBLIC_AUTH_PROVIDERS=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Guidon <noreply@useguidon.com>

# Optional - copy the ones you use from Vercel:
# GITHUB_CLIENT_ID= GITHUB_CLIENT_SECRET= GITHUB_APP_CLIENT_ID= GITHUB_APP_CLIENT_SECRET= GITHUB_APP_SLUG=
# DISCORD_BOT_TOKEN= DISCORD_CLIENT_ID=
# AI_PROVIDER= AI_MODEL= GROQ_API_KEY=
# SENTRY_DSN= NEXT_PUBLIC_SENTRY_DSN=
# POSTHOG_PROJECT_TOKEN= POSTHOG_HOST= NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN= NEXT_PUBLIC_POSTHOG_HOST=
# MCP_REGISTRY_PUBLIC_KEY=
